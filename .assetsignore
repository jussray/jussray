# Not part of the deployed SPA — governance docs, CI/tooling config, and
# the Worker source itself. Wrangler uploads everything under the assets
# directory by default; this keeps the deployed bundle to the app only.
#
# Unlike Pages, Workers static assets do NOT auto-exclude .git — it must
# be listed explicitly or the full repo history (and anything ever
# committed to it) ships as publicly servable files.
.git/
**/.git
.wrangler/
.env
.env.*
.dev.vars
.dev.vars.*
.npmrc
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
*.jks
**/*.jks
*.keystore
**/*.keystore
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite-*
CLAUDE.md
CHATGPT.md
PERPLEXITY.md
AGENTS.md
README.md
docs/
.github/
node_modules/
package.json
package-lock.json
tsconfig.json
eslint.config.js
vitest.config.js
LICENSE
**/*.test.js
**/*.test.mjs
**/*.test.ts
test/
test/**/*.mjs
coverage/
scripts/
.control-room/
.claude/
.cursor/
.vscode/
.security/
.gitignore
.assetsignore
tools/
.github/workflows/
playwright.config.cjs
tests/

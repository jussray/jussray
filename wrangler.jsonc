{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jussray",
  "compatibility_date": "2026-10-01",
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/support-chat"
    ]
  },
  "routes": [
    {
      "pattern": "jussco.company",
      "custom_domain": true
    },
    {
      "pattern": "www.jussco.company",
      "custom_domain": true
    }
  ],
  "main": "./workers/support-chat.mjs",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "SUPPORT_RATE_LIMITER",
      "namespace_id": "91426",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}

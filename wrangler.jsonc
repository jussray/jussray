{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jussray",
  "type": "service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site"
  },
  "routes": [
    {
      "pattern": "jussco.company",
      "custom_domain": true
    },
    {
      "pattern": "www.jussco.company",
      "custom_domain": true
    }
  ]
}

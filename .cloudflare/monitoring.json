{
  "monitoring": {
    "enabled": true,
    "version": "1.0",
    "tls": {
      "enabled": true,
      "domains": ["jussco.company", "www.jussco.company"],
      "alerts": {
        "expiration": {
          "enabled": true,
          "daysBeforeExpiry": 30,
          "severity": "critical"
        }
      }
    },
    "https": {
      "enabled": true,
      "enforceRedirect": true,
      "alertOnDowngrade": true,
      "tlsMinVersion": "1.2"
    },
    "csp": {
      "enabled": true,
      "reportUri": "/_csp-report",
      "alertThreshold": {
        "violations_per_hour": 10
      }
    },
    "performance": {
      "enabled": true,
      "metrics": {
        "responseTime": {
          "enabled": true,
          "slo_ms": 500,
          "alertThreshold_ms": 1000
        },
        "errorRate": {
          "enabled": true,
          "alertThreshold_percent": 1.0
        },
        "cacheHitRate": {
          "enabled": true,
          "target_percent": 95
        }
      }
    },
    "fcr_mail": {
      "enabled": true,
      "endpoints": [
        {
          "name": "fcr_mail_api",
          "url": "https://fcr-mail.internal/health",
          "timeout_seconds": 10,
          "interval_seconds": 60
        }
      ],
      "metrics": {
        "deliveryRate": {
          "enabled": true,
          "target_percent": 99.5,
          "alertThreshold_percent": 98.0
        },
        "latency": {
          "enabled": true,
          "slo_ms": 5000,
          "alertThreshold_ms": 15000
        },
        "failureRate": {
          "enabled": true,
          "alertThreshold_percent": 0.5
        }
      }
    }
  },
  "alerting": {
    "enabled": true,
    "channels": {
      "email": {
        "enabled": true,
        "recipients": {
          "primary": "juss@example.com",
          "backup": "ops@example.com"
        }
      },
      "webhook": {
        "enabled": true,
        "url": "https://hooks.internal/alerts",
        "retry": {
          "max_attempts": 3,
          "backoff_ms": 1000
        }
      }
    },
    "escalation": {
      "enabled": true,
      "policies": [
        {
          "severity": "warning",
          "delay_minutes": 5,
          "action": "notify_primary"
        },
        {
          "severity": "critical",
          "delay_minutes": 0,
          "actions": ["notify_primary", "notify_backup", "log_incident"]
        }
      ]
    },
    "rules": [
      {
        "id": "tls_expiry_30d",
        "condition": "cert_expiry_days <= 30",
        "severity": "critical",
        "title": "TLS Certificate expiring within 30 days",
        "channels": ["email", "webhook"]
      },
      {
        "id": "https_enforcement",
        "condition": "http_request_detected",
        "severity": "high",
        "title": "Non-HTTPS request detected",
        "channels": ["webhook"]
      },
      {
        "id": "csp_violations",
        "condition": "csp_violations_per_hour > 10",
        "severity": "medium",
        "title": "CSP violations exceeded threshold",
        "channels": ["email"]
      },
      {
        "id": "worker_error_rate",
        "condition": "error_rate_percent > 1.0",
        "severity": "high",
        "title": "Worker error rate above threshold",
        "channels": ["email", "webhook"]
      },
      {
        "id": "fcr_mail_delivery",
        "condition": "fcr_mail_delivery_rate < 98.0",
        "severity": "critical",
        "title": "fcr_mail delivery rate below SLO",
        "channels": ["email", "webhook"]
      }
    ]
  },
  "metrics": {
    "retention_days": 30,
    "granularity": "1h",
    "export": {
      "enabled": true,
      "format": "json",
      "kv_bucket": "jussray-metrics"
    }
  }
}
